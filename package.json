{
  "name": "perron-ns-g2",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "engines": {
    "node": "^20.17.0 || ^22.13.0 || >=23.5.0"
  },
  "description": "Glanceable NS (Dutch Railways) departures for Even Realities G2 — Even Hub app.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:coverage": "npm test",
    "test:watch": "vitest",
    "qr": "evenhub qr --http",
    "pack": "npm run build && evenhub pack app.json dist -o perron-ns.ehpk",
    "simulate": "evenhub-simulator http://localhost:5173",
    "simulate:auto": "evenhub-simulator http://localhost:5173 --automation-port 9898"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.11"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.12",
    "@evenrealities/evenhub-simulator": "^0.7.2",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.6",
    "jsdom": "^26.1.0",
    "magic-string": "^0.30.21",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
